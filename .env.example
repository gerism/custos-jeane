# URL do PostgreSQL do Railway (Variables > DATABASE_URL, o Railway ja cria pra voce)
DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# Chave secreta pra assinar o token de login. Troque por qualquer texto longo e aleatorio.
JWT_SECRET=troque-isso-por-um-texto-bem-aleatorio-e-grande

# Porta que o servidor vai escutar (o Railway define isso sozinho em producao)
PORT=3000
